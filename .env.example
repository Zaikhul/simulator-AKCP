# CLI overrides environment variables. Run from the root of the repository.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=wit
MQTT_PASSWORD=123456789
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_ACK_TIMEOUT_MS=10000
MQTT_RECONNECT_MS=1000
MQTT_KEEPALIVE=30
# For mqtts:// only (certificate verification is always enabled):
# MQTT_CA_FILE=certs/ca.pem
# MQTT_CERT_FILE=certs/client.pem
# MQTT_KEY_FILE=certs/client-key.pem
# MQTT_SERVERNAME=broker.example.org
AKCP_DEVICES_FILE=config/devices.json
# Values on MQTT are engineering units by default. For native scaled integers:
# AKCP_VALUE_FORMAT=raw
AKCP_VALUE_FORMAT=engineering
# Optional single-device MAC override; omitted to use the configured MAC.
# AKCP_MAC=000BDCDE4001
# Automatically generated client IDs include the MAC and a random suffix.
# AKCP_CLIENT_ID=akcp-sim-000BDCDE4001-unique
SIM_INTERVAL_SECONDS=5
SIM_PROFILE=realistic
SIM_SPEED=1
SIM_SEED=42
SIM_DURATION_SECONDS=0
# SIM_SCENARIO_FILE=config/scenario-demo.json
API_HOST=127.0.0.1
API_PORT=3000
API_DB_FILE=data/monitoring.db
API_MAX_TELEMETRY_ROWS=100000
# Protect data endpoints with Authorization: Bearer <token>, when configured.
# API_TOKEN=your-own-token
LOG_LEVEL=info
